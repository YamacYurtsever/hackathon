# Copy to .env.local (gitignored via *.local) and fill in.
#
# Only used by the unwired extraction lab in src/lib/extraction — see its
# README. Not needed to run the app.
#
# NOT prefixed with VITE_ on purpose: it is meant to be read by the Vite dev
# server and attached to proxied requests server-side, so it never reaches the
# browser bundle. The proxy entry it depends on is not currently in
# vite.config.ts; the lab's README explains what to add.
MISTRAL_API_KEY=

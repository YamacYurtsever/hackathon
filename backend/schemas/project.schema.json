{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "project.schema.json",
  "title": "Project",
  "description": "A project owns a list of IR entry ids and a list of member user ids — IR entries and users don't point back to a project.",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "ir": {
      "type": "array",
      "entries": { "type": "string" }
    },
    "users": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
